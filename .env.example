# Required. Reown (WalletConnect) project ID from https://dashboard.reown.com
# In the Reown dashboard, add zatrise.xyz (and your *.vercel.app preview domain) to the project's allowed domains.
VITE_REOWN_PROJECT_ID=

# Optional: custom RPC endpoints (for example an Alchemy URL). Leave empty to use the public Robinhood Chain RPCs.
VITE_RPC_URL_MAINNET=
VITE_RPC_URL_TESTNET=
